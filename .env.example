# Скопируйте в .env и заполните значения. Файл .env не коммитится.
# Сгенерировать ключ:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# База данных: по умолчанию SQLite (db.sqlite3). Для PostgreSQL:
# DATABASE_URL=postgres://sms_guard:<пароль>@localhost:5432/sms_guard
DATABASE_URL=

# true при работе по HTTPS
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

LOG_LEVEL=INFO

# Необязательно (ФТ-3.11): ключ Google Safe Browsing API
SAFE_BROWSING_API_KEY=
