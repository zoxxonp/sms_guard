@startuml use_case
' Диаграмма вариантов использования — SMS Guard (задание 1)
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5F8FC
  BorderColor #2F5597
}
skinparam defaultFontName Arial

actor "Гость" as Guest
actor "Пользователь" as User
actor "Администратор" as Admin
actor "Сервис репутации URL\n(опционально)" as Rep <<system>>

User <|-- Admin

rectangle "SMS Guard" {
  usecase "UC-01 Зарегистрироваться" as UC1
  usecase "UC-02 Войти в систему" as UC2
  usecase "UC-03 Выйти из системы" as UC3
  usecase "UC-04 Проверить SMS" as UC4
  usecase "UC-05 Проверить ссылку (URL)" as UC5
  usecase "UC-06 Просмотреть результат\nи объяснение" as UC6
  usecase "UC-07 Просмотреть историю\nпроверок (фильтры)" as UC7
  usecase "UC-08 Удалить запись истории" as UC8
  usecase "UC-09 Просмотреть Dashboard" as UC9
  usecase "UC-10 Управлять профилем\n(пароль, согласие на хранение)" as UC10
  usecase "UC-11 Экспортировать историю в CSV" as UC11
  usecase "UC-12 Просмотреть статистику\nпо всем пользователям" as UC12
  usecase "UC-13 Просмотреть активные\nверсии моделей" as UC13

  usecase "Извлечь ссылки из текста" as INC1
  usecase "Рассчитать Risk Score" as INC2
  usecase "Запросить репутацию URL" as EXT1
}

Guest --> UC1
Guest --> UC2

User --> UC3
User --> UC4
User --> UC5
User --> UC7
User --> UC9
User --> UC10
User --> UC11

Admin --> UC12
Admin --> UC13

UC4 ..> INC1 : <<include>>
UC4 ..> INC2 : <<include>>
UC5 ..> INC2 : <<include>>
INC1 ..> UC5 : <<include>>
UC4 ..> UC6 : <<include>>
UC5 ..> UC6 : <<include>>
UC8 ..> UC7 : <<extend>>
UC11 ..> UC7 : <<extend>>
EXT1 ..> UC5 : <<extend>>
EXT1 -- Rep
@enduml
